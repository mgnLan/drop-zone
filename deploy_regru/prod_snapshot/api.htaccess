# Godot web-экспорт сам распаковывает ответ, который fetch уже распаковал,
# и падает с RESULT_BODY_DECOMPRESS_FAILED (код 8). Ответы API ~100 байт,
# сжимать их всё равно нечего.
SetEnv no-gzip 1
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI . no-gzip dont-vary
</IfModule>

<FilesMatch "\.sqlite$">
  Require all denied
</FilesMatch>
<FilesMatch "\.sqlite$">
  Order allow,deny
  Deny from all
</FilesMatch>
